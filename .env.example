# Copy to .env. Every setting is optional; the app works with none of them.

# Optional: enables Claude-written cited answers. Without it the answer panel uses an extractive fallback.
ANTHROPIC_API_KEY=
SIFT_CLAUDE_MODEL=claude-sonnet-5-5
SIFT_CLAUDE_EFFORT=low          # low | medium | high
SIFT_ANSWER_TOP_K=5             # BM25 results passed to the answer step

SIFT_DB=sift.db                 # SQLite file (pages, inverted index, analytics)
SIFT_SEED=1                     # load the bundled offline corpus when the database is empty
SIFT_DEMO_TRAFFIC=1             # replay ~400 simulated searches once so the dashboard has data (tagged "demo")

SIFT_CACHE_SIZE=256             # LRU query cache entries
SIFT_CACHE_TTL=300              # seconds, 0 = never expire
SIFT_PAGE_SIZE=10

SIFT_BM25_K1=1.2
SIFT_BM25_B=0.75
SIFT_TITLE_BOOST=0.6            # extra idf weight for query terms found in the title
